@model IEnumerable<StudentCrud.Models.StudentModel>
<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

@{
    ViewBag.Title = "Show";

}
@{
    if (TempData["ins"] != null)
    {
        string ins = TempData["ins"].ToString();
        <script type="text/javascript">
         alert('@ins');
        </script>
    }
    if (TempData["del"] != null)
    {
        string del = TempData["del"].ToString();
        <script type="text/javascript">
       alert('@del');
        </script>
    }
}
<div class="container border-opacity-25" style="border-radius:3px; background-color:aliceblue;box-shadow:0px 0px 10px 2px">
    <br />
    <table class="table" id="studentsTable">
        <div style="display: flex; align-items: center; justify-content: space-between;">
            <h2>
                Students
            </h2>
            <div>
                <button id="printButton" class="btn btn-warning">Print</button>
                <button id="exportButton" class="btn btn-danger">Download Excel</button>
            </div>


        </div>
        <hr />
        <br />
        <tr>
            <th>
                @Html.DisplayName("Sr no")
            </th>
            <th>
                @Html.DisplayName("Name")
            </th>
            <th>
                @Html.DisplayName("Age")
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PhoneNum)
            </th>
            <th>
                @Html.DisplayName("Actions")
            </th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @ViewBag.c
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SName)
                </td>
                <td>
                    @(DateTime.Now.Subtract(item.DOB).Days / 365)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PhoneNum)
                </td>
                <td>
                    <a href="@Url.Action("Edit", new { id = item.Id })">
                        <i class="fa fa-edit" style="font-size:25px;"> <span style="color:black;padding-right: 15px; padding-left:15px" "> </span></i>
                    </a>
                    <a href="@Url.Action("ViewD", new { id = item.Id })">
                        <i class="fa fa-search" style="font-size:20px;"><span style="color: black; padding-right: 15px; padding-left:15px"></span></i>
                    </a>
                    <a href="@Url.Action("Delete", new { id = item.Id })">
                        <i class="fa fa-remove" style="font-size:25px; font-weight:10px;"><span style="color:black;padding-right: 15px; padding-left:15px" "> </span></i>
                    </a>
                </td>
                @{ ViewBag.c = ViewBag.c + 1;

                }
            </tr>
        }
    </table>

    <br />
    <hr />

    <div style="margin-left:40%">
        @if (ViewBag.TotalPages > 1)
        {
            <nav aria-label="Page navigation">
                <ul class="pagination">
                    @if (ViewBag.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("StudentShow", new { pageNumber = ViewBag.CurrentPage - 1, pageSize = ViewBag.PageSize })">Previous</a>
                        </li>
                    }

                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action("StudentShow", new { pageNumber = i, pageSize = ViewBag.PageSize })">@i</a>
                        </li>
                    }

                    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("StudentShow", new { pageNumber = ViewBag.CurrentPage + 1, pageSize = ViewBag.PageSize })">Next</a>
                        </li>
                    }
                </ul>
            </nav>
        }

        <br />
    </div>

</div>


@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

    <script>

        $("#printButton").click(function () {
            var printContents = document.getElementById('studentsTable').outerHTML;
            var originalContents = document.body.innerHTML;

            document.body.innerHTML = "<h2>Student List</h2>" + printContents;
            window.print();
            document.body.innerHTML = originalContents;
            location.reload();
        });

        $("#exportButton").click(function () {
            var table = document.getElementById('studentsTable');
            var workbook = XLSX.utils.table_to_book(table, { sheet: "Students" });
            XLSX.writeFile(workbook, 'Students.xlsx');
        });

        if (!TempData["success"]) {
            alert(@TempData["success"])
        } else {
            alert(@TempData["success"])
        }
    </script>
}